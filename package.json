{
  "name": "rendering-strategies",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:classic": "npm run dev -w classic",
    "dev:ppr": "npm run dev -w ppr",
    "build": "npm run build -w classic && npm run build -w ppr",
    "build:classic": "npm run build -w classic",
    "build:ppr": "npm run build -w ppr",
    "analyze:rsc": "node scripts/rsc-graph.mjs",
    "analyze:rsc:check": "node scripts/rsc-graph.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3"
  }
}
