{
  "name": "cloudflare-opennext-15",
  "description": "Uses OpenNext for Cloudflare on Next.js 15",
  "version": "1.0.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/node": "20",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "eslint": "8",
    "eslint-config-next": "^15.3.3",
    "postcss": "8",
    "tailwindcss": "3.4.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  },
  "resolutions": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6"
  }
}
