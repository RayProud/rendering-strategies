{
  "name": "cloudflare-opennext-14",
  "description": "Uses OpenNext for Cloudflare on Next.js 14",
  "version": "1.0.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "14.2.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "send-headers": "workspace:*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@opennextjs/cloudflare": "1.11.0",
    "@types/node": "20",
    "@types/react": "18",
    "@types/react-dom": "18",
    "eslint": "8",
    "eslint-config-next": "14.2.29",
    "postcss": "8",
    "tailwindcss": "3.4.1",
    "typescript": "^5.8.3",
    "wrangler": "4.45.4"
  }
}
